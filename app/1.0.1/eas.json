{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": "versionCode",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ios": {
      "distribution": "internal",
      "autoIncrement": "buildNumber"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
