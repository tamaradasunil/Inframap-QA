{
  "expo": {
    "name": "InfraMap",
    "slug": "inframap-preview",
    "scheme": "inframappreview",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.inframap.preview",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.inframap.preview",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow InfraMap to select property and shop photos.",
          "cameraPermission": "Allow InfraMap to take property and shop photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow InfraMap to show your location and add property or shop locations."
        }
      ]
    ],
    "extra": {}
  }
}
